      },
      "id": "0184ba82-306c-40f0-89b5-c4423a417482",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -260,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o"
        },
        "messages": {
          "values": [
            {
              "content": "Sos un JUEZ tecnico. Evalua la respuesta del agente contra la query y el contexto recuperado. Devolve SOLO el JSON del schema. Criterio: exactitud_factual>=4 => ACEPTADO; parcial => CORREGIR; falsa/alucinada => RECHAZADO.\n\nQUERY: {{ $json.query }}\nCONTEXTO: {{ $json.contexto }}\nRESPUESTA: {{ $json.respuesta_propuesta }}"
            }
          ]
        },
        "jsonSchema": "{\"type\":\"object\",\"properties\":{\"exactitud_factual\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":5},\"estado_veredicto\":{\"type\":\"string\",\"enum\":[\"ACEPTADO\",\"CORREGIR\",\"RECHAZADO\"]},\"critica\":{\"type\":\"string\"}},\"required\":[\"exactitud_factual\",\"estado_veredicto\",\"critica\"]}",
        "jsonOutput": true,
        "options": {}
      },
      "id": "eb7f90eb-321d-46c3-aafc-059fed139abb",
      "name": "Juez LLM (Structured Output)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        -20,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {},
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.message.content.estado_veredicto }}",
                    "rightValue": "ACEPTADO",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "outputKey": "ACEPTADO"
            },
            {
              "conditions": {
                "options": {},
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.message.content.estado_veredicto }}",
                    "rightValue": "CORREGIR",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "outputKey": "CORREGIR"
            },
            {
              "conditions": {
                "options": {},
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.message.content.estado_veredicto }}",
                    "rightValue": "RECHAZADO",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "outputKey": "RECHAZADO"
            }
          ]
        },
        "options": {}
      },
